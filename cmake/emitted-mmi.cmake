# Apply after the VU0 and source-size properties are assigned. Preserve source
# order and each generated module's own headers/PCH/unity settings.
set(mmi_emitted_private "${boot_private}/emitted-mmi")
set(mmi_emitted_list "${boot_private}/emitted-mmi-sources.txt")
set(mmi_emitted_fixture "${CMAKE_CURRENT_SOURCE_DIR}/tests/fixtures/mmi/raw_permutations.cpp")
set(mmi_emitted_targets yakuza_boot_probe ${YAKUZA_BOOT_OVERLAY_TARGETS})
set(mmi_emitted_sources "${mmi_emitted_fixture}")
foreach(target IN LISTS mmi_emitted_targets)
    get_target_property(sources "${target}" SOURCES)
    foreach(source IN LISTS sources)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE absolute_source)
        list(APPEND mmi_emitted_sources "${absolute_source}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES mmi_emitted_sources)
list(JOIN mmi_emitted_sources "\n" mmi_emitted_text)
file(WRITE "${mmi_emitted_list}" "${mmi_emitted_text}\n")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/tools/prepare_emitted_mmi.py" "${mmi_emitted_fixture}")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/prepare_emitted_mmi.py"
    --source-list "${mmi_emitted_list}"
    --emitter-source "${ps2recomp_SOURCE_DIR}/ps2xRecomp/src/lib/mmi_translation_helpers.cpp"
    --out-dir "${mmi_emitted_private}" COMMAND_ERROR_IS_FATAL ANY)
include("${mmi_emitted_private}/corrections.cmake")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${YAKUZA_EMITTED_MMI_INPUTS})
foreach(target IN LISTS mmi_emitted_targets)
    get_target_property(sources "${target}" SOURCES)
    set(replaced)
    foreach(source IN LISTS sources)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE absolute_source)
        list(FIND YAKUZA_EMITTED_MMI_INPUTS "${absolute_source}" position)
        if(position LESS 0)
            list(APPEND replaced "${source}")
        else()
            list(GET YAKUZA_EMITTED_MMI_OUTPUTS ${position} replacement)
            list(APPEND replaced "${replacement}")
            foreach(property IN ITEMS INCLUDE_DIRECTORIES SKIP_PRECOMPILE_HEADERS SKIP_UNITY_BUILD_INCLUSION)
                get_source_file_property(value "${source}" "${property}")
                if(NOT value STREQUAL "NOTFOUND")
                    set_source_files_properties("${replacement}" PROPERTIES "${property}" "${value}")
                endif()
            endforeach()
        endif()
    endforeach()
    set_property(TARGET "${target}" PROPERTY SOURCES "${replaced}")
endforeach()
list(FIND YAKUZA_EMITTED_MMI_INPUTS "${mmi_emitted_fixture}" fixture_position)
if(fixture_position LESS 0)
    message(FATAL_ERROR "Original-free emitted MMI fixture was not prepared")
endif()
list(GET YAKUZA_EMITTED_MMI_OUTPUTS ${fixture_position} YAKUZA_EMITTED_MMI_TEST_SOURCE)
