# Optional Linux-to-Windows cross build. Native Windows builds use MSVC.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(YAKUZA_LLVM_MINGW_ROOT "$ENV{YAKUZA_LLVM_MINGW_ROOT}" CACHE PATH "Verified LLVM-MinGW installation")
if(NOT IS_DIRECTORY "${YAKUZA_LLVM_MINGW_ROOT}/bin")
    message(FATAL_ERROR "Set YAKUZA_LLVM_MINGW_ROOT to a verified LLVM-MinGW installation")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES YAKUZA_LLVM_MINGW_ROOT)
set(CMAKE_C_COMPILER "${YAKUZA_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${YAKUZA_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${YAKUZA_LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_FIND_ROOT_PATH "${YAKUZA_LLVM_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
